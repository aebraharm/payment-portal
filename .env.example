# Copy to .env for local development. Never commit real values.
# Every value below is a placeholder. Production values belong in the hosting provider's
# environment settings (for example Netlify site environment variables), not in files.

# --- Core -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5173
APP_TIME_ZONE=Africa/Lagos
# At least 32 random characters in production. Generate with: openssl rand -base64 48
APP_SECRET=replace-with-32-plus-random-characters
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# --- Database -------------------------------------------------------------
# Production: managed PostgreSQL (TLS recommended). Leave empty in development to use the embedded database in DATA_DIR.
DATABASE_URL=
DATABASE_SSL=true
DATA_DIR=.data

# --- Receipts (private storage) -------------------------------------------
RECEIPT_STORAGE=local
RECEIPT_STORAGE_DIR=.data/receipts
RECEIPT_MAX_BYTES=5242880
# S3-compatible private bucket. Required when RECEIPT_STORAGE=s3 (always the case on Netlify).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email (SMTP). Leave SMTP_HOST empty to record notifications as "not configured" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Payments <payments@example.com>

# --- First administrator (one-time command, see docs/DEPLOYMENT.md) --------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator

# --- Scheduled reminders -----------------------------------------------------
# Long random value. Required to call POST /api/internal/reminders manually. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Sessions and rate limits (optional; defaults shown) ----------------------
ADMIN_SESSION_HOURS=8
CLIENT_SESSION_HOURS=24
RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_PER_EMAIL=5
ADMIN_LOGIN_MAX_PER_IP=50
CLIENT_LOGIN_MAX_PER_NAME=5
CLIENT_LOGIN_MAX_PER_IP=50
RESET_REQUESTS_MAX_PER_EMAIL=3
