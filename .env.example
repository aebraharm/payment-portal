# ============================================================================
# Environment configuration — copy this file to `.env` and fill in real values.
# NEVER commit real credentials. This file contains placeholder names only.
# ============================================================================

# --- Server ---------------------------------------------------------------
# Port the Node/Express server listens on.
PORT=4000
# Set to "production" when deployed (enables secure cookies, HTTPS assumptions).
NODE_ENV=development
# Bind address. Production defaults to 127.0.0.1 (loopback) so the API is
# reachable ONLY through your reverse proxy; development defaults to 0.0.0.0.
# HOST=127.0.0.1
# Number of reverse-proxy hops in front of the app (1 = nginx directly in
# front, the documented setup). Set to 2 when adding e.g. Cloudflare in front
# of nginx. Only change this together with your proxy topology.
# TRUST_PROXY=1

# --- Database -------------------------------------------------------------
# Two drivers share one query layer:
#   sqlite  — a local file (default; the VPS setup). Needs a persistent disk.
#   libsql  — a hosted database (Turso, or any libSQL server). Required on
#             Netlify, where there is no disk that outlives one invocation.
# Setting TURSO_DATABASE_URL selects libsql automatically, so DB_DRIVER is only
# needed to force sqlite or to be explicit.
# DB_DRIVER=sqlite
# Path to the SQLite database file. For production you may point this at a
# mounted volume. See DEPLOYMENT.md for backup and migration notes.
DATABASE_PATH=server/data/portal.db

# Hosted database (libsql). Both are required with DB_DRIVER=libsql; the app
# refuses to start rather than silently running on an empty local file.
# TURSO_DATABASE_URL=libsql://payment-portal-<org>.turso.io
# TURSO_DATABASE_TOKEN=
# Aliases are accepted: LIBSQL_URL, LIBSQL_AUTH_TOKEN.
# Per-operation timeout, so a network hiccup fails a request instead of
# hanging it until the host's function timeout.
# DB_TIMEOUT_MS=15000

# --- Uploads / file storage ----------------------------------------------
# Two drivers share one storage layer:
#   fs — a private directory on disk (default; the VPS setup).
#   s3 — a private S3-compatible bucket. Required on Netlify.
# Setting S3_BUCKET selects s3 automatically.
# STORAGE_DRIVER=fs
# Private directory for receipt uploads and branding assets. Must NOT be
# served as a public static directory; files are streamed through
# authenticated API endpoints only.
UPLOAD_DIR=server/uploads

# Private bucket for receipts (STORAGE_DRIVER=s3). The bucket must block public
# access; nothing in the app ever generates a public object URL.
# S3_BUCKET=
# S3_REGION=auto
# Endpoint only for S3-compatible hosts (Cloudflare R2, Backblaze B2, MinIO,
# DigitalOcean Spaces). Leave unset for real AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Required by R2/B2/MinIO/Spaces; leave false for AWS S3.
# S3_FORCE_PATH_STYLE=true
# All objects live under this key prefix, so one bucket can hold several apps.
# S3_PREFIX=payment-portal
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Aliases accepted: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# Off by default: AWS encrypts new objects anyway, and R2/B2/MinIO reject the
# parameter. Turn on only if your provider needs the explicit header.
# S3_SERVER_SIDE_ENCRYPTION=false

# --- Rate limiting ---------------------------------------------------------
# The counter store. `memory` is fine for one long-lived process; `db` keeps
# the windows in the database so every function invocation shares them.
# RATE_LIMIT_STORE=memory   # memory | db — db is required (and auto-selected)
#                           # when the app runs serverless or on libsql
# Attempts per window, and the window length in milliseconds.
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# --- Administrator bootstrap ----------------------------------------------
# Initial administrator account, created idempotently by `npm run seed`.
# The account is flagged to change this password on first login.
# BOTH variables must be set for the account to be created — there is no
# built-in default, so a deployment can never bootstrap an administrator
# with a publicly documented identity.
# Do NOT hardcode real credentials in source control.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_INITIAL_PASSWORD

# --- Sessions -------------------------------------------------------------
# Sessions are cryptographically random tokens (256-bit) stored only as
# SHA-256 hashes in the database — no signing secret is required.
# Session lifetime in hours (idle sessions expire).
SESSION_TTL_HOURS=8

# --- Email (optional) -----------------------------------------------------
# If SMTP is not configured, notifications are stored in the database and
# marked as "email not configured" — the app never pretends an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Payment Portal <no-reply@example.com>"
NOTIFY_ADMIN_EMAIL=

# --- Branding defaults (optional overrides; admins can edit in the portal) -
# BRAND_PRIMARY_COLOR=#2563eb
# BRAND_SECONDARY_COLOR=#0b2447
