{
  "name": "payment-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Configurable immigration agency payment portal with separate client and admin portals.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/node.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:bootstrap-admin": "tsx server/scripts/bootstrap-admin.ts",
    "jobs:reminders": "tsx server/scripts/reminders.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
